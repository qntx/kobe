{
  "name": "@qntx/wallet-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "vp run @qntx/wallet#build && vp check && bun scripts/check-version.ts",
    "typecheck": "vp run -r typecheck && tsc --noEmit",
    "test": "vp run -r test",
    "test:coverage": "vp run -r test:coverage",
    "test:browser": "vp run @qntx/wallet-worker#test:browser",
    "check:pkg": "vp run @qntx/wallet#check:pkg && vp run @qntx/wallet-worker#check:pkg",
    "smoke:hermes": "bun run --cwd packages/wallet-worker smoke:hermes",
    "harness:bundles": "bun scripts/harness-bundles.ts",
    "release": "bumpp",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qntx/oxfmt": "1.1.1",
    "@qntx/oxlint": "1.1.1",
    "@qntx/tsconfig": "1.0.1",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "bumpp": "12.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
