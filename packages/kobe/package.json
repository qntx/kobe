{
  "name": "@qntx/kobe",
  "version": "3.4.0",
  "description": "Multi-chain HD wallet SDK in TypeScript",
  "keywords": [
    "bip39",
    "crypto",
    "hd-wallet",
    "typescript",
    "wallet"
  ],
  "homepage": "https://github.com/qntx/kobe#readme",
  "bugs": {
    "url": "https://github.com/qntx/kobe/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/kobe.git",
    "directory": "packages/kobe"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "smoke:hermes": "bun scripts/hermes-smoke.ts",
    "check:pkg": "vp pack && publint && attw --pack . --profile esm-only",
    "pack:local": "vp pack && bun pm pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.3",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
