{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "tests", "vite.config.ts"],
  // DOM and WebWorker code live in nested per-directory tsconfig.json programs
  // (src/browser, src/worker's browser files, tests/browser/page); each is also the
  // project the type-aware lint service assigns those files to.
  "exclude": [
    "src/browser",
    "src/worker/browser.ts",
    "src/worker/indexeddb.ts",
    "tests/browser/page"
  ]
}
