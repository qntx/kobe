{
  // The declaration program for `vp pack`: both published entries and their transitive
  // imports in ONE program, with DOM + Node types available (each entry only exercises the
  // side it targets). Per-environment correctness is enforced by the nested tsconfigs in
  // src/browser, src/worker and the typecheck script — not by this file.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["src/browser/index.ts", "src/node/index.ts"],
  "exclude": []
}
