{
  "name": "@qntx/wallet-kernel",
  "version": "0.2.0",
  "private": true,
  "description": "qntx/wallet secret enclave kernel (private, bundled by the host packages)",
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/wallet.git",
    "directory": "packages/wallet-kernel"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vp run @qntx/wallet#build && vp test",
    "test:coverage": "vp run @qntx/wallet#build && vp test --coverage",
    "typecheck": "vp run @qntx/wallet#build && tsc --noEmit && tsc --noEmit -p tsconfig.src.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qntx/nostr": "0.14.0",
    "@qntx/wallet": "0.2.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
