{
  // The Playwright test page is DOM code; the spec files one level up stay in the package
  // program (Node types, @playwright/test).
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    // The page exercises the built dist at runtime (package exports); for typecheck the
    // source entry keeps dist builds out of the dependency chain.
    "paths": {
      "@qntx/wallet-wasm/browser": ["../../../src/browser/index.ts"]
    }
  },
  "include": ["."]
}
