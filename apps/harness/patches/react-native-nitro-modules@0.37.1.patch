diff --git a/node_modules/react-native-nitro-modules/cpp/utils/RuntimeCacheMutex.hpp b/cpp/utils/RuntimeCacheMutex.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..849cebe5013e1fb425af59cc3169770790935fc2
--- /dev/null
+++ b/cpp/utils/RuntimeCacheMutex.hpp
@@ -0,0 +1,30 @@
+//
+//  RuntimeCacheMutex.hpp
+//  NitroModules
+//
+//  Local patch, pending an upstream fix in mrousavy/nitro (not filed yet):
+//  Nitro's process-wide caches — PropNameIDCache::_cache,
+//  HybridObjectPrototype::_prototypeCache, JSICache::_globalCache,
+//  CommonGlobals::_cache, Prototype::_prototypesCache, NitroTypeInfo's regex
+//  cache, HybridObjectRegistry's constructor map (all accessors) and
+//  Dispatcher::_globalCache —
+//  are unsynchronized, so touching them from a second jsi::Runtime on another
+//  thread races with the main runtime and corrupts the unordered_maps
+//  (observed: SIGSEGV inside unordered_map::emplace during nitro::install).
+//  One recursive mutex covers all of them: they call into each other
+//  (createPrototype → JSICache::getOrCreateCache → PropNameIDCache::get)
+//  while holding it.
+//
+
+#pragma once
+
+#include <mutex>
+
+namespace margelo::nitro {
+
+inline std::recursive_mutex& runtimeCacheMutex() {
+  static std::recursive_mutex mutex;
+  return mutex;
+}
+
+} // namespace margelo::nitro
